POSTGRES_USER=eventcheck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eventcheck
POSTGRES_PORT=5433
DATABASE_URL="postgresql://eventcheck:change-me@localhost:5433/eventcheck?schema=public"
# Cloud Run supplies PORT automatically.
# PORT=8080

# Local development fallback
SERVER_PORT=3000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development
SEED_PARTICIPANT_PASSWORD="Test123!"
SEED_ORGANIZER_PASSWORD="Test123!"
# Optional isolated E2E configuration; keep this database separate from eventcheck.
E2E_DATABASE_URL="postgresql://eventcheck:change-me@127.0.0.1:5433/eventcheck_test?schema=public"
E2E_API_PORT=3101
E2E_WEB_PORT=5178
E2E_ORGANIZER_LOGIN=organizer@example.test
E2E_PARTICIPANT_LOGIN=participant@example.test
# E2E passwords default to the SEED_* values when omitted.
VITE_API_PROXY_TARGET="http://127.0.0.1:3000"
# Optional E2E password overrides.
# When omitted, Playwright uses the SEED_*_PASSWORD values.
# E2E_ORGANIZER_PASSWORD=local-test-password
# E2E_PARTICIPANT_PASSWORD=local-test-password

# Optional E2E evidence capture (0 = disabled, 1 = enabled).
# E2E_CAPTURE_EVIDENCE=0
